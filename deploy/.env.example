# Production Domain & TLS configuration
DOMAIN=reseller.example.com
ACME_EMAIL=admin@example.com

# Container Registry Images (GHCR)
API_IMAGE=ghcr.io/farras-mik/reseller-agent-api:latest
WEB_IMAGE=ghcr.io/farras-mik/reseller-agent-web:latest

# Web Frontend Build Arguments
NEXT_PUBLIC_API_URL=/api

# Scraper Hardening & Proxy configuration
SCRAPER_PROXY_URL=
SCRAPER_COOLDOWN_SECONDS=2

# External Fallback Search APIs (Optional)
TAVILY_API_KEY=
SERPER_API_KEY=

# Server LLM API Keys (Optional if users supply BYOK in frontend)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
